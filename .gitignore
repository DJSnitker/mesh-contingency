# Runtime configuration: holds real email addresses and node keys.
# Copy config.example.toml and users.example.toml instead.
config.toml
users.toml
# What the bot saves while running: check-ins, mailbox messages, join requests,
# the last scheduled advert, the weather alerts already posted, where to ask
# about each county's weather, the history of admin actions, and backups of
# users.toml.
status.json
mailbox.json
requests.json
adverts.json
alerts.json
area_weather.json
watch.json
backup.json
history.json
*.json.tmp
backups/
# The web console's link, with the key that opens it.
console.url
console.url.tmp
# The web console's app, built from console/ (npm run build); packaged, not committed.
mesh_contingency/web/static/

