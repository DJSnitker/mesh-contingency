{
  "name": "mesh-contingency-app",
  "version": "0.11.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "format": "prettier --write src electron",
    "format:check": "prettier --check src electron",
    "android": "ng build && cap sync android",
    "demo": "ng serve --configuration demo",
    "emulator:setup": "scripts/android.sh setup",
    "emulator": "scripts/android.sh emulator",
    "android:run": "scripts/android.sh run",
    "android:live": "scripts/android.sh live",
    "desktop": "ng build && electron .",
    "desktop:run": "electron .",
    "desktop:dist": "ng build && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@liamcottle/meshcore.js": "^1.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "description": "Mesh Contingency, the app: your MeshCore radio over Bluetooth or USB.",
  "author": {
    "name": "Doug Snitker",
    "email": "DJSnitker@users.noreply.github.com"
  },
  "homepage": "https://github.com/DJSnitker/mesh-contingency",
  "license": "SEE LICENSE IN LICENSE",
  "desktopName": "mesh-contingency-app.desktop"
}
